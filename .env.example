# Personal Assistant: environment variables.
# .env.example is the committed template, with every value left blank.
# .env is your local copy with real values. It is in .gitignore: never commit it.
# When deployed, the same names go in Replit Secrets.

# --- Milestone 0: voice in, task out ---

# Claude, the main model (console.anthropic.com)
ANTHROPIC_API_KEY=

# ElevenLabs: Scribe speech-to-text now, text-to-speech later
ELEVENLABS_API_KEY=

# Shared secret the iPhone Shortcut sends with every request, so only my phone
# can call the server. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ASSISTANT_TOKEN=

# --- Milestone 1: calendar, to-dos, facts memory ---

# Google OAuth client (Calendar read-only and Tasks; Gmail read-only + drafts in M2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in after the one-time Google sign-in step
GOOGLE_REFRESH_TOKEN=

# Postgres with pgvector. Replit sets this automatically for its database.
DATABASE_URL=

# --- Milestone 4: long-term memory ---

# OpenAI, used only for embeddings (text-embedding-3-small)
OPENAI_API_KEY=
